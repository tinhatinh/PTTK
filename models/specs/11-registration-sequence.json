    }
  ],
  "steps": [
    {
      "from": "A",
      "to": "UI",
      "name": "POST /register",
      "kind": "call"
    },
    {
      "from": "UI",
      "to": "UI",
      "name": "service() kiểm tra CSRF",
      "kind": "call"
    },
    {
      "from": "UI",
      "to": "S",
      "name": "register(input)",
      "kind": "call"
    },
    {
      "from": "S",
      "to": "S",
      "name": "normalize(input); validate(input)",
      "kind": "call"
    },
    {
      "fragment": "alt",
      "operands": [
        {
          "guard": "dữ liệu hợp lệ",
          "steps": [
            {
              "from": "S",
              "to": "P",
              "name": "hash(password)",
              "kind": "call"
            },
            {
              "from": "P",
              "to": "S",
              "name": "passwordHash",
              "kind": "return"
            },
            {
              "from": "S",
              "to": "D",
              "name": "saveRegistration(input,passwordHash)",
              "kind": "call"
            },
            {
              "from": "D",
              "to": "DB",
              "name": "setAutoCommit(false); INSERT account; INSERT customer",
              "kind": "call"
            },
            {
              "fragment": "alt",
              "operands": [
                {
                  "guard": "không có lỗi SQL",
                  "steps": [
                    {
                      "from": "D",
                      "to": "DB",
                      "name": "commit()",
                      "kind": "call"
                    },
                    {
                      "from": "D",
                      "to": "S",
                      "name": "customerId",
                      "kind": "return"
                    },
                    {
                      "from": "S",
                      "to": "UI",
                      "name": "customerId",
                      "kind": "return"
                    },
                    {
                      "from": "UI",
                      "to": "A",
                      "name": "HTTP 303 /registered",
                      "kind": "return"
                    }
                  ]
                },
                {
                  "guard": "trùng hoặc lỗi ghi",
                  "steps": [
                    {
                      "from": "D",
                      "to": "DB",
                      "name": "rollback()",
                      "kind": "call"
                    },
                    {
                      "from": "D",
                      "to": "S",
                      "name": "SQLException",
                      "kind": "return"
                    },
                    {
                      "from": "S",
                      "to": "UI",
                      "name": "SQLException",
                      "kind": "return"
                    },
                    {
                      "from": "UI",
                      "to": "A",
                      "name": "HTTP 409 hoặc 500 + biểu mẫu",
                      "kind": "return"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "guard": "dữ liệu sai",
          "steps": [
            {
              "from": "S",
              "to": "UI",
              "name": "IllegalArgumentException",
              "kind": "return"
            },
            {
              "from": "UI",
              "to": "A",
              "name": "HTTP 400 + biểu mẫu",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
