@startuml 08-revenue-design
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #33444C
skinparam classBackgroundColor #F8FBFB
skinparam classBorderColor #335D64
skinparam packageBorderColor #60757D
skinparam roundcorner 6
skinparam dpi 150
skinparam maxMessageSize 180
hide empty members
top to bottom direction
class AppServlet0 <<servlet>> {
 -revenue : RevenueDAO0
 -reportPage(q,r) : void
 -showtimesPage(q,r) : void
 -invoicesPage(q,r) : void
 -range(q) : LocalDate[]
 -id(q,name) : long
}
class View0 <<view>> {
 +{static} page(title,body,manager,csrf) : String
 +{static} e(x) : String
 +{static} money(x : Number) : String
}
class RevenueService0 <<validation>> {
 +{static} validateRange(from,to) : void
}
class RevenueDAO0 <<DAO>> {
 -db : Database0
 +getMovieRevenueStats(from,to) : List<MovieRevenue0>
 +getShowtimeStats(movieId,from,to) : List<ShowtimeRevenue0>
 +getInvoicesByShowtime(showtimeId,from,to) : List<InvoiceRevenue0>
 -bind(statement,from,to) : void
}
class Database0 {
 +open() : Connection
}
class MovieRevenue0 <<record>> {
-movieId : long
-title : String
-showtimeCount : long
-ticketCount : long
-revenue : BigDecimal
-fromDate : LocalDate
-toDate : LocalDate
}
class ShowtimeRevenue0 <<record>> {
-showtimeId : long
-movieTitle : String
-roomName : String
-startsAt : LocalDateTime
-ticketCount : long
-revenue : BigDecimal
-fromDate : LocalDate
-toDate : LocalDate
}
class InvoiceRevenue0 <<record>> {
-invoiceId : long
-issuedAt : LocalDateTime
-customerName : String
-ticketCount : long
-revenue : BigDecimal
-fromDate : LocalDate
-toDate : LocalDate
}
AppServlet0 ..> View0
AppServlet0 ..> MovieRevenue0
AppServlet0 ..> ShowtimeRevenue0
AppServlet0 ..> InvoiceRevenue0
AppServlet0 ..> RevenueService0
AppServlet0 --> RevenueDAO0
RevenueDAO0 --> Database0
RevenueDAO0 ..> MovieRevenue0
RevenueDAO0 ..> ShowtimeRevenue0
RevenueDAO0 ..> InvoiceRevenue0
@enduml
