@startuml 04a-registration-states
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
state "Hiển thị trang chủ" as home
state "Hiển thị biểu mẫu đăng ký" as form
state "Hiển thị đăng ký thành công" as result
[*] --> home
home --> form : Chọn Đăng ký thành viên
form --> form : Nhập sai hoặc trùng / báo lỗi
form --> result : Đăng ký hợp lệ / lưu thành công
form --> home : Về trang chủ
result --> home : Về trang chủ
@enduml
