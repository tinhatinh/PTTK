@startuml 04b-revenue-states
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
state "Hiển thị trang quản lý" as home
state "Hiển thị chọn loại báo cáo" as type
state "Hiển thị thống kê phim" as movies
state "Hiển thị thống kê suất chiếu" as shows
state "Hiển thị hóa đơn của suất" as invoices
[*] --> home
home --> type : Chọn Xem báo cáo
type --> movies : Chọn thống kê / Tiếp tục
movies --> movies : Nhập ngày / Xem thống kê
movies --> shows : Chọn một phim
shows --> invoices : Chọn một suất
invoices --> shows : Các suất chiếu
shows --> movies : Thống kê phim
movies --> type : Chọn loại thống kê
type --> home : Trang quản lý
@enduml
