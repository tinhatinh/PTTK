@startuml 04-revenue-analysis
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
class ManagerUI0 <<boundary>> {
 -subViewReport
}
class ReportTypeUI0 <<boundary>> {
 -outReportType
 -subContinue
 -subBack
}
class MovieStatsUI0 <<boundary>> {
 -inFromDate
 -inToDate
 -subViewStatistics
 -outsubMovieStats
 -outError
 -subBack
}
class ShowtimeStatsUI0 <<boundary>> {
 -outMovieTitle
 -outPeriod
 -outsubShowtimeStats
 -subBack
}
class InvoiceListUI0 <<boundary>> {
 -outShowtimeContext
 -outInvoices
 -outTotal
 -subBack
}
class Account0 <<entity>> {
 -username
 -password
 -fullName
 -role
}
class Customer0 <<entity>> {
 -memberCode
 -phone
 -email
 -registeredAt
}
class Movie0 <<entity>> {
 -title
 -durationMinutes
}
class Room0 <<entity>> {
 -name
}
class Showtime0 <<entity>> {
 -startsAt
}
class Invoice0 <<entity>> {
 -issuedAt
 -status
}
class Ticket0 <<entity>> {
 -unitPrice
}
class MovieRevenue0 <<entity>> {
 -showtimeCount
 -ticketCount
 -revenue
 -fromDate
 -toDate
 +getMovieRevenueStats(from,to)
}
class ShowtimeRevenue0 <<entity>> {
 -ticketCount
 -revenue
 -fromDate
 -toDate
 +getShowtimeStats(movie,from,to)
}
class InvoiceRevenue0 <<entity>> {
 -ticketCount
 -revenue
 -fromDate
 -toDate
 +getInvoicesByShowtime(showtime,from,to)
}
Account0 "1" -- "0..1" Customer0
Customer0 "0..1" -- "0..*" Invoice0
Movie0 "1" -- "0..*" Showtime0
Room0 "1" -- "0..*" Showtime0
Invoice0 "1" *-- "1..*" Ticket0
Showtime0 "1" -- "0..*" Ticket0
MovieRevenue0 --|> Movie0
ShowtimeRevenue0 --|> Showtime0
InvoiceRevenue0 --|> Invoice0
ManagerUI0 -- ReportTypeUI0
ReportTypeUI0 -- MovieStatsUI0
MovieStatsUI0 -- ShowtimeStatsUI0
ShowtimeStatsUI0 -- InvoiceListUI0
MovieStatsUI0 -- MovieRevenue0
ShowtimeStatsUI0 -- ShowtimeRevenue0
InvoiceListUI0 -- InvoiceRevenue0
@enduml
