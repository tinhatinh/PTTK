@startuml 06-revenue-communication
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 15
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #33444C
skinparam classBackgroundColor #F8FBFB
skinparam classBorderColor #335D64
skinparam packageBorderColor #60757D
skinparam roundcorner 6
skinparam dpi 150
skinparam maxMessageSize 180
hide empty members
allowmixing
top to bottom direction
actor "Quản lý" as A
object ":MovieStatsUI0" as UI
object ":Movie0" as M
object ":ShowtimeStatsUI0" as SU
object ":Showtime0" as S
object ":InvoiceListUI0" as IU
object ":Invoice0" as I
A --> UI : 1: chọn khoảng ngày\n2: subViewStatistics
UI --> M : 2.1: getMovieRevenueStats(from,to)
M --> UI : 2.2: danh sách phim
A --> UI : 3: subMovie(movieId)
UI --> SU : 3.1: chuyển movieId, from, to
SU --> S : 3.2: getShowtimeStats(movieId,from,to)
S --> SU : 3.3: danh sách suất
A --> SU : 4: subShowtime(showtimeId)
SU --> IU : 4.1: chuyển showtimeId, movieId, from, to
IU --> I : 4.2: getInvoicesByShowtime(showtimeId,from,to)
I --> IU : 4.3: danh sách hóa đơn
@enduml
