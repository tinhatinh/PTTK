@startuml 03-registration-analysis
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
class HomeUI0 <<boundary>> {
 -subRegisterMember
}
class RegistrationUI0 <<boundary>> {
 -inFullName
 -inPhone
 -inEmail
 -inUsername
 -inPassword
 -inConfirmPassword
 -subRegister
 -subHome
 -outError
}
class RegistrationResultUI0 <<boundary>> {
 -outCustomerId
 -outFullName
 -subHome
}
class Account0 <<entity>> {
 -username
 -password
 -fullName
 -role
}
class Customer0 <<entity>> {
 -memberCode
 -phone
 -email
 -registeredAt
 +register(info)
}
Account0 "1" -- "0..1" Customer0
HomeUI0 -- RegistrationUI0
RegistrationUI0 -- RegistrationResultUI0
RegistrationUI0 -- Customer0
@enduml
