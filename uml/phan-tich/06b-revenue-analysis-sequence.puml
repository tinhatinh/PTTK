@startuml 06b-revenue-analysis-sequence
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
actor "Nhân viên quản lý" as A
participant "ManagerUI0" as H
participant "ReportTypeUI0" as T
participant "MovieStatsUI0" as M
participant "MovieRevenue0" as MS
participant "ShowtimeStatsUI0" as S
participant "ShowtimeRevenue0" as SS
participant "InvoiceListUI0" as I
participant "InvoiceRevenue0" as IS
A -> H : 1: Chọn Xem báo cáo
H -> T : 2: Mở chọn loại báo cáo
T --> A : 3: Hiển thị loại báo cáo
A -> T : 4: Chọn thống kê và Tiếp tục
T -> M : 5: Mở biểu mẫu ngày
M --> A : 6: Hiển thị biểu mẫu ngày
A -> M : 7: Nhập ngày và Xem thống kê
M -> MS : 8: Yêu cầu thống kê phim
MS -> MS : 9: getMovieRevenueStats(from,to)
MS --> M : 10: Trả danh sách thống kê phim
M --> A : 11: Hiển thị bảng phim
A -> M : 12: Chọn một phim
M -> S : 13: Chuyển phim và khoảng ngày
S -> SS : 14: Yêu cầu thống kê suất
SS -> SS : 15: getShowtimeStats(movie,from,to)
SS --> S : 16: Trả danh sách thống kê suất
S --> A : 17: Hiển thị bảng suất chiếu
A -> S : 18: Chọn một suất
S -> I : 19: Chuyển suất và ngữ cảnh
I -> IS : 20: Yêu cầu hóa đơn của suất
IS -> IS : 21: getInvoicesByShowtime(showtime,from,to)
IS --> I : 22: Trả danh sách hóa đơn
I --> A : 23: Hiển thị hóa đơn và tổng
@enduml
